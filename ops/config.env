# claude-autopilot configuration
MISSION_START=2026-01-01
MISSION_END=2099-12-31          # SET THIS: agent stops itself after this date
PROFIT_TARGET=0                 # 0 = disabled; >0 = stop when ledger net >= target
MAX_AI_RUNS_PER_DAY=3           # on Pro/Max plans, headless runs share your interactive limits
AI_MODEL=${AI_MODEL:-sonnet}
AI_MAX_TURNS=30
# SESSION_PROMPT="..."          # optional: replaces the default "follow AGENTS.md, work TASKS.md" prompt
RATE_LIMIT_PAUSE_SECONDS=18000  # pause 5h after a usage-limit message (never retries)
ERROR_PAUSE_SECONDS=3600
